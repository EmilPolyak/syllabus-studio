# Runtime data written by publish.php on the server: the published instructor tools
# (<slug>.json) and the bcrypt owner hashes (<slug>.owner). The folder itself and its
# .htaccess guard ARE tracked, so a deploy ships with the guard already in place.
dist/configs/*
!dist/configs/.htaccess

# Revision archive written by /policy_admin on the server.
dist/defaults/history/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
